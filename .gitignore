# Local secrets and environment overrides
**/.env*
!**/.env.example
!**/.env.local.example

# Dependencies and build output
**/node_modules/
**/.next/
**/.vercel/
**/*.tsbuildinfo
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/coverage/
**/playwright-report/
**/test-results/
**/*.log

# Local data and uploaded evidence
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
Backend/uploads/*
!Backend/uploads/.gitkeep

# Stale handoff archives should not be submitted as source
*.rar

# OS and editor files
.DS_Store
Thumbs.db
