# --- Application ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./karobaar.db
# Comma-separated list of allowed frontend origins (Vercel domain goes here later)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# No automatic sample data. Offline test fixtures are loaded by tests only.
AUTO_SEED=false
# Folder where uploaded receipt images are stored
UPLOADS_DIR_PATH=uploads
# Local filesystem for booth development; private Blob for Vercel deployments.
RECEIPT_STORAGE=local
# Injected by the connected private Vercel Blob store. OIDC is request scoped.
BLOB_STORE_ID=

# Set true for any shared/staging/production deployment.
REQUIRE_AUTH=false
# Supabase project URL (required when REQUIRE_AUTH=true).
SUPABASE_URL=
# Server-side only. Needed for legacy HS256 projects; asymmetric projects use JWKS.
SUPABASE_JWT_SECRET=

# --- AI Provider Selection ---
# auto   = real Groq first, real Gemini fallback (voice/text/receipts)
# groq   = Groq only (text/audio/receipt vision)
# gemini = Gemini only (text/audio/receipts)
# demo   = explicit LOCAL offline test fixture; disabled in deployed environments
# No configured real key or all APIs unavailable => clear error, never Demo fallback.
AI_PROVIDER=auto

# Groq (first priority) - key from https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (fallback) - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Model overrides (defaults are usually fine) ---
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.6-flash

# Per-call AI timeout in seconds (transcription/vision can be slower)
AI_TIMEOUT_SECONDS=60
