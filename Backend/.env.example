# --- Application ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./karobaar.db
# Comma-separated list of allowed frontend origins (Vercel domain goes here later)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Auto-load demo seed data when the database is empty (recommended for demos)
AUTO_SEED=true
# Folder where uploaded receipt images are stored
UPLOADS_DIR_PATH=uploads

# Set true for any shared/staging/production deployment.
REQUIRE_AUTH=false
# Supabase project URL (required when REQUIRE_AUTH=true).
SUPABASE_URL=
# Server-side only. Needed for legacy HS256 projects; asymmetric projects use JWKS.
SUPABASE_JWT_SECRET=

# --- AI Provider Selection ---
# auto   = Groq first, Gemini fallback, Demo floor (default)
# groq   = Groq only (Demo floor still applies)
# gemini = Gemini only (Demo floor still applies)
# demo   = always use the built-in deterministic provider (offline demo)
AI_PROVIDER=auto

# Groq (first priority) - key from https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (fallback) - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Model overrides (defaults are usually fine) ---
GROQ_TEXT_MODEL=qwen/qwen3-32b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_MODEL=gemini-2.5-flash

# Per-call AI timeout in seconds (transcription/vision can be slower)
AI_TIMEOUT_SECONDS=60
