{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {"root": "frontend/", "framework": "nextjs"},
    "backend": {
      "root": "Backend/", "framework": "fastapi", "entrypoint": "app.main:app",
      "functions": {"app/main.py": {"maxDuration": 300, "excludeFiles": "{tests/**,scripts/**,uploads/**,.venv/**,*.md}"}}
    }
  },
  "regions": ["hnd1"],
  "rewrites": [
    {"source": "/api/(.*)", "destination": {"service": "backend"}},
    {"source": "/(.*)", "destination": {"service": "frontend"}}
  ]
}
